---
import Base from '../layouts/Base.astro';
import '../styles/global.css';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles', ({data}) => !data.draft)).sort((a,b) => b.data.updated.valueOf()-a.data.updated.valueOf()).slice(0,3);
const cats = [['digimon','Digimon'],['item','Items'],['quest','Quests'],['guide','Guides'],['patch','Patches']];
---
<Base title="DMO Field Notes | Digimon Master Online wiki"><section class="hero"><div class="hero-inner"><p class="eyebrow">[KEY ART] · FAN-MAINTAINED REFERENCE</p><h1>Digimon Master Online, recorded for the next run.</h1><p class="lede">A focused wiki for checking Digimon, items, quests, guides, and patch notes. Verified content will appear as articles are added.</p><a class="button" href="/wiki">Open the Digimon wiki</a></div></section><section class="section" id="about"><p class="eyebrow">ABOUT THE GAME</p><h2>What is DMO?</h2><p class="lede">Digimon Master Online is an online game set in the Digimon universe. This site documents game knowledge in Markdown. Where a fact still needs a source, this site says so.</p></section><section class="section"><div class="section-head"><div><p class="eyebrow">WIKI INDEX</p><h2>Choose a starting point</h2></div><a href="/wiki">View all articles</a></div><div class="category-grid">{cats.map(([slug,label])=><a href={`/wiki?category=${slug}`}><strong>{label}</strong><br /><span class="muted">Browse {label.toLowerCase()} articles</span></a>)}</div></section><section class="section"><div class="section-head"><div><p class="eyebrow">LATEST NOTES</p><h2>Recent writing</h2></div></div>{articles.length ? <div class="article-list">{articles.map(({data,slug})=><a class="article-card" href={`/wiki/${slug}`}><span class="eyebrow">{data.category} · {data.updated.toISOString().slice(0,10)}</span><h3>{data.title}</h3><span class="muted">{data.description}</span></a>)}</div> : <div class="status">No published articles yet. Add a Markdown article and set draft to false before building.</div>}</section></Base>
